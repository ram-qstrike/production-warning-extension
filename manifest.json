{
  "manifest_version": 3,
  "name": "Production Environment Warning",
  "version": "2.0.0",
  "description": "Warns users when accessing production websites.",

  "permissions": ["storage"],

  "host_permissions": ["http://*/*", "https://*/*"],

  "icons": {
    "128": "icon.png"
  },

  "action": {
    "default_title": "Production Website Manager",
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["warning.css"],
      "run_at": "document_idle"
    }
  ]
}
