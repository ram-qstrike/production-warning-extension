{
  "manifest_version": 3,
  "name": "Production Environment Warning",
  "version": "1.0.0",
  "description": "Warns users when they are testing on production.",

  "permissions": ["tabs", "scripting"],

  "host_permissions": ["https://*/*"],

  "icons": {
    "16": "icon16.png",
    "24": "icon24.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },

  "action": {
    "default_title": "Production Environment Warning",
    "default_icon": {
      "16": "icon16.png",
      "24": "icon24.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "css": ["warning.css"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["commands.js"],
      "matches": ["https://*/*"]
    }
  ]
}
